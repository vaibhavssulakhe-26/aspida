{
  "manifest_version": 3,
  "name": "Aspida",
  "version": "1.0.0",
  "description": "Explains whether links, QR codes, chats and emails show phishing risk signals. All analysis is local.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/state/normal-16.png",
    "32": "icons/state/normal-32.png",
    "48": "icons/state/normal-48.png",
    "128": "icons/state/normal-128.png"
  },
  "action": {
    "default_title": "Aspida settings",
    "default_icon": {
      "16": "icons/state/normal-16.png",
      "32": "icons/state/normal-32.png",
      "48": "icons/state/normal-48.png"
    }
  },
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "options_page": "src/ui/options/options.html",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "alarms",
    "webNavigation"
  ],
  "host_permissions": [
    "https://raw.githubusercontent.com/*",
    "https://openphish.com/*",
    "https://urlhaus-api.abuse.ch/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "src/content/loader.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/content/*",
        "src/ui/render.js",
        "src/ui/overlay.js",
        "src/platform/messaging.js",
        "src/platform/storage.js",
        "src/config/settings.js",
        "src/config/strings/*",
        "src/config/tlds.js",
        "src/qr/decode.js",
        "src/core/qr-payload.js",
        "src/core/report.js",
        "src/ui/clipboard.js",
        "vendor/jsqr/jsQR.js",
        "src/content/sites/*"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "use_dynamic_url": false
    }
  ]
}
